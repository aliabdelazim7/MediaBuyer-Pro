# 1. Database Connection URL (SQLite for local / PostgreSQL for Vercel e.g. Supabase or Neon)
DATABASE_URL="file:./dev.db"

# 2. Meta Graph API (User Access Token / System User Token)
META_ACCESS_TOKEN=""
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_WEBHOOK_VERIFY_TOKEN="crm_secret_verify_token_2026"

# 3. Telegram Bot Notifications (Optional)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"

# 4. Environment
NODE_ENV="production"
PORT=3000
